  14:  CALL _EFF_MES    ;
  15:  MESSAGE[LOCAL TIP CHANGE] ;
  16:  MESSAGE[...] ;
  17:  MESSAGE[PLEASE CONFIRM CHANGE] ;
  18:  MESSAGE[BY PRESS SHIFT IO] ;
  19:  MESSAGE[ON TEACH PENDANT] ;
  20:   ;
  21:  LBL[2] ;
  22:   ;
  23:  DO[30]=ON ;
  24:   ;
