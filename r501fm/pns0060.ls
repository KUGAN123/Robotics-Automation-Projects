/PROG  PNS0060
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "K2_IND_HP";
PROG_SIZE	= 260;
CREATE		= DATE 18-04-16  TIME 17:12:52;
MODIFIED	= DATE 18-04-16  TIME 17:12:52;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 4;
MEMORY_SIZE	= 632;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  OVERRIDE=100% ;
   2:  CALL IO_RESET    ;
   3:  CALL PNS0059    ;
   4:  CALL IO_RESET    ;
/POS
/END
