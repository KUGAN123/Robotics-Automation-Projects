/PROG  TWZRCLB2	  Macro
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Zero calib.";
PROG_SIZE	= 1137;
CREATE		= DATE 06-04-24  TIME 11:03:16;
MODIFIED	= DATE 26-06-23  TIME 23:02:16;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 26;
MEMORY_SIZE	= 1625;
PROTECT		= READ;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,1,*,*,*;
CONTROL_CODE	= 00000000 00000001;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  R[10]=0    ;
   2:  LBL[1000] ;
   3:  IF $SGGUN1.$SGTWD.$RETRY_FLG<>234567,JMP LBL[3000] ;
   4:  IF $SGGUN1.$SGTWD.$MISDETECT>0,JMP LBL[2000] ;
   5:  IF $SGSYSTWD.$RETRY_ENB<>1,JMP LBL[3000] ;
   6:  LBL[2000] ;
   7:L P[1] 500mm/sec CNT0    ;
   8:  CALL TWKSTROK    ;
   9:  LBL[3000] ;
  10:  CALL TWKPCOND(98,10,98) ;
  11:  IF R[10]=2,JMP LBL[20] ;
  12:  $SGGUN1.$SGTWD.$RETRY_FLG=234567 ;
  13:  PRESS_MOTN[SD=98,P=98] ;
  14:  JMP LBL[30] ;
  15:  LBL[20] ;
  16:  $SGGUN1.$SGTWD.$RETRY_FLG=234567 ;
  17:  PRESS_MOTN[SD=(98,98),P=(...,98)] ;
  18:  LBL[30] ;
  19:  WAIT    .50(sec) ;
  20:  CALL TWKPULSE(1) ;
  21:  IF $SGGUN1.$SGTWD.$MISDETECT<>0,JMP LBL[2000] ;
  22:  Gun Zero Master[1] ;
  23:  IF R[10]=R[10],JMP LBL[999] ;
  24:  LBL[999] ;
  25:  $SGGUN1.$SGTWD.$RETRY_FLG=0 ;
  26:  END ;
/POS
P[1]{
   GP2:
	UF : 0, UT : 1,	
	J1=   -59.373  mm
};
/END
