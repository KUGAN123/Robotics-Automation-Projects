/PROG  _EFF_MES_NEW
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Efface Message";
PROG_SIZE	= 304;
CREATE		= DATE 15-05-24  TIME 14:16:20;
MODIFIED	= DATE 15-05-24  TIME 14:16:20;
FILE_NAME	= _EFF_MES;
VERSION		= 0;
LINE_COUNT	= 5;
MEMORY_SIZE	= 788;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  R[134]=0    ;
   2:  LBL[10] ;
   3:  MESSAGE[...] ;
   4:  R[134]=R[134]+1    ;
   5:  IF R[134]<=10,JMP LBL[10] ;
/POS
/END
