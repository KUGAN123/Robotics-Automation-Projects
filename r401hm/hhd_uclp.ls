/PROG  HHD_UCLP
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "HAND_HOOD_UNCLAM";
PROG_SIZE	= 330;
CREATE		= DATE 10-06-29  TIME 23:03:08;
MODIFIED	= DATE 11-11-09  TIME 17:48:18;
FILE_NAME	= CLAMP;
VERSION		= 0;
LINE_COUNT	= 8;
MEMORY_SIZE	= 670;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  DO[65:HAND COMMON CLAMP ADV]=OFF ;
   2:  DO[71:HAND CLAMP T/LID  ADV]=OFF ;
   3:  DO[66:HAND COMMON CLAMP RET]=ON ;
   4:  DO[72:HAND CLAMP T/LID  RET]=ON ;
   5:  WAIT DI[66:HAND COMMON CLAMP RET.ED]=ON    ;
   6:  WAIT DI[72:HAND CLAMP T/LID  RET.ED]=ON    ;
   7:  DO[66:HAND COMMON CLAMP RET]=OFF ;
   8:  DO[71:HAND CLAMP T/LID  ADV]=OFF ;
/POS
/END
