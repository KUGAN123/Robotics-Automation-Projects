/PROG  H_SW_BD
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "HAND_BDOOR_SWING";
PROG_SIZE	= 272;
CREATE		= DATE 10-06-29  TIME 23:03:08;
MODIFIED	= DATE 11-11-09  TIME 17:48:14;
FILE_NAME	= CLAMP;
VERSION		= 0;
LINE_COUNT	= 4;
MEMORY_SIZE	= 628;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  DO[73:HAND GAUGE SWING ADV]=OFF ;
   2:  DO[74:HAND GAUGE SWING RET]=ON ;
   3:  WAIT DI[74:HAND GAUGE SWING RET.ED]=ON    ;
   4:  DO[73:HAND GAUGE SWING ADV]=OFF ;
/POS
/END
