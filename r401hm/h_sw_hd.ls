/PROG  H_SW_HD
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "HAND_HOOD_SWING";
PROG_SIZE	= 246;
CREATE		= DATE 13-09-24  TIME 12:23:12;
MODIFIED	= DATE 13-09-24  TIME 12:23:12;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 4;
MEMORY_SIZE	= 602;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  DO[74:HAND GAUGE SWING RET]=OFF ;
   2:  DO[73:HAND GAUGE SWING ADV]=ON ;
   3:  WAIT DI[73:HAND GAUGE SWING ADV.ED]=ON    ;
   4:  DO[74:HAND GAUGE SWING RET]=OFF ;
/POS
/END
