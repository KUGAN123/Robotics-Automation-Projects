/PROG  HHD_CLP
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "HAND_HOOD_CLAMP";
PROG_SIZE	= 300;
CREATE		= DATE 10-06-29  TIME 22:59:08;
MODIFIED	= DATE 11-11-09  TIME 17:48:18;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 8;
MEMORY_SIZE	= 640;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  DO[66:HAND COMMON CLAMP RET]=OFF ;
   2:  DO[72:HAND CLAMP T/LID  RET]=OFF ;
   3:  DO[65:HAND COMMON CLAMP ADV]=ON ;
   4:  DO[71:HAND CLAMP T/LID  ADV]=ON ;
   5:  WAIT DI[65:HAND COMMON CLAMP ADV.ED]=ON    ;
   6:  WAIT DI[71:HAND CLAMP T/LID  ADV.ED]=ON    ;
   7:  DO[65:HAND COMMON CLAMP ADV]=OFF ;
   8:  DO[72:HAND CLAMP T/LID  RET]=OFF ;
/POS
/END
