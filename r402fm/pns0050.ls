MODIFIED	= DATE 24-01-19  TIME 12:44:54;
FILE_NAME	= PNS0045;
VERSION		= 0;
LINE_COUNT	= 11;
MEMORY_SIZE	= 694;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
/MN
   1:  TIMER[8]=RESET ;
   2:  TIMER[8]=START ;
   3:  OVERRIDE=100% ;
   4:  CALL IO_RST    ;
