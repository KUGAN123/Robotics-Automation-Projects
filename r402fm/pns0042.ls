/PROG  PNS0042
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "HBC PH2";
PROG_SIZE	= 504;
CREATE		= DATE 26-04-04  TIME 23:46:00;
MODIFIED	= DATE 26-05-25  TIME 09:48:28;
FILE_NAME	= PNS0052;
VERSION		= 0;
LINE_COUNT	= 19;
MEMORY_SIZE	= 824;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
/MN
   1:  R[72:HBC CYL TIME]=TIMER[8]    ;
   2:  TIMER[8]=RESET ;
   3:  TIMER[8]=START ;
   4:  OVERRIDE=100% ;
   5:  R[80]=R[50:SPOT COUNT  ]    ;
   6:  CALL IO_RST    ;
   7:  DO[15]=ON ;
   8:  R[72:HBC CYL TIME]=0    ;
   9:  R[55:HBC]=0    ;
  10:  //CALL HBC_PH2_29JPH_NOV    ;
  11:   ;
  12:  CALL HBC_35JPH_APR    ;
  13:  R[81]=R[50:SPOT COUNT  ]    ;
  14:  DO[15]=OFF ;
  15:  CALL IO_RST    ;
  16:   ;
  17:  TIMER[8]=STOP ;
  18:  R[55:HBC]=R[81]-R[80]    ;
  19:  R[72:HBC CYL TIME]=TIMER[8]    ;
/POS
/END
