/PROG  PNS0051
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "PY1B MC INN";
PROG_SIZE	= 352;
CREATE		= DATE 25-03-31  TIME 05:18:12;
MODIFIED	= DATE 25-03-31  TIME 05:18:12;
FILE_NAME	= PNS0054;
VERSION		= 0;
LINE_COUNT	= 9;
MEMORY_SIZE	= 704;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  TIMER[8]=RESET ;
   2:  TIMER[8]=START ;
   3:  CALL IO_RST    ;
   4:  DO[15]=ON ;
   5:  CALL PNS0054    ;
   6:  DO[15]=OFF ;
   7:  CALL IO_RST    ;
   8:   ;
   9:  TIMER[8]=STOP ;
/POS
/END
