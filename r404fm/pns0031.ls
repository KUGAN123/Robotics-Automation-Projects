/PROG  PNS0031
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "K2_MC";
PROG_SIZE	= 342;
CREATE		= DATE 20-11-20  TIME 10:34:20;
MODIFIED	= DATE 20-11-20  TIME 10:34:20;
FILE_NAME	= PNS0040;
VERSION		= 0;
LINE_COUNT	= 7;
MEMORY_SIZE	= 710;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  TIMER[5]=RESET ;
   2:  TIMER[5]=START ;
   3:  CALL IO_RST    ;
   4:  CALL K2MC_27JPH    ;
   5:  CALL IO_RST    ;
   6:  //CALL K2MC_33JPH    ;
   7:  TIMER[5]=STOP ;
/POS
/END
