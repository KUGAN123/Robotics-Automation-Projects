/PROG  IWC_RST	  Macro
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Reset Welder";
PROG_SIZE	= 202;
CREATE		= DATE 11-01-31  TIME 16:21:40;
MODIFIED	= DATE 11-01-31  TIME 16:22:08;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 1;
MEMORY_SIZE	= 570;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
