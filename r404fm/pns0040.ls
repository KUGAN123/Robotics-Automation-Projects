/PROG  PNS0040
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "L02B_INDIA";
PROG_SIZE	= 286;
CREATE		= DATE 13-06-14  TIME 22:14:04;
MODIFIED	= DATE 14-10-24  TIME 13:06:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 6;
MEMORY_SIZE	= 650;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  TIMER[5]=RESET ;
   2:  TIMER[5]=START ;
   3:  CALL IO_RST    ;
   4:  CALL L02B_40    ;
   5:  CALL IO_RST    ;
   6:  TIMER[5]=STOP ;
/POS
/END
