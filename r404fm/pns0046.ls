/PROG  PNS0046
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "RBC HR10";
PROG_SIZE	= 476;
CREATE		= DATE 26-05-26  TIME 09:48:36;
MODIFIED	= DATE 26-05-26  TIME 09:48:44;
FILE_NAME	= PNS0043;
VERSION		= 0;
LINE_COUNT	= 16;
MEMORY_SIZE	= 800;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  R[71:RBC CYL TIME]=TIMER[8]    ;
   2:  TIMER[8]=RESET ;
   3:  TIMER[8]=START ;
   4:  R[80]=R[50:SPOT COUNT]    ;
   5:  CALL IO_RST    ;
   6:  DO[15]=ON ;
   7:  R[71:RBC CYL TIME]=0    ;
   8:  R[54:RBC]=0    ;
   9:   ;
  10:  CALL RBC_35JPH_APR    ;
  11:  R[81]=R[50:SPOT COUNT]    ;
  12:  DO[15]=OFF ;
  13:  CALL IO_RST    ;
  14:  R[54:RBC]=R[81]-R[80]    ;
  15:  TIMER[8]=STOP ;
  16:  R[71:RBC CYL TIME]=TIMER[8]    ;
/POS
/END
