/PROG  PNS0042
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "HBC PH2";
PROG_SIZE	= 534;
CREATE		= DATE 26-04-07  TIME 16:23:46;
MODIFIED	= DATE 26-05-25  TIME 09:56:26;
FILE_NAME	= PNS0052;
VERSION		= 0;
LINE_COUNT	= 20;
MEMORY_SIZE	= 850;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  R[72:HBC CYL TIME]=TIMER[8]    ;
   2:  TIMER[8]=RESET ;
   3:  TIMER[8]=START ;
   4:  OVERRIDE=100% ;
   5:  R[80]=R[50:SPOT COUNT]    ;
   6:   ;
   7:  CALL IO_RST    ;
   8:  DO[15]=ON ;
   9:  R[72:HBC CYL TIME]=0    ;
  10:  R[55:HBC]=0    ;
  11:  //CALL HBC_PH2_29JPH_NOV    ;
  12:   ;
  13:  CALL HBC_35JPH_APR    ;
  14:   ;
  15:  R[81]=R[50:SPOT COUNT]    ;
  16:  DO[15]=OFF ;
  17:  CALL IO_RST    ;
  18:  R[55:HBC]=R[81]-R[80]    ;
  19:  TIMER[8]=STOP ;
  20:  R[72:HBC CYL TIME]=TIMER[8]    ;
/POS
/END
