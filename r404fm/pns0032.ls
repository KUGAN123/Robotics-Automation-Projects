/PROG  PNS0032
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "MPV_MC";
PROG_SIZE	= 340;
CREATE		= DATE 20-11-20  TIME 10:35:04;
MODIFIED	= DATE 20-11-20  TIME 10:35:04;
FILE_NAME	= PNS0031;
VERSION		= 0;
LINE_COUNT	= 7;
MEMORY_SIZE	= 708;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  TIMER[5]=RESET ;
   2:  TIMER[5]=START ;
   3:  CALL IO_RST    ;
   4:  CALL PNS0031    ;
   5:  //CALL K2MPV_33JPH    ;
   6:  CALL IO_RST    ;
   7:  TIMER[5]=STOP ;
/POS
/END
