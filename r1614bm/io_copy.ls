/PROG  IO_COPY	  Macro
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Inter connect G1";
PROG_SIZE	= 380;
CREATE		= DATE 12-08-03  TIME 15:22:18;
MODIFIED	= DATE 13-03-04  TIME 14:04:18;
FILE_NAME	= IO_COPY;
VERSION		= 0;
LINE_COUNT	= 9;
MEMORY_SIZE	= 716;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  DO[145:ISO CONTACTOR ]=(DI[97:ISO CONTACTOR]) ;
   2:  DO[148:TR THERMO NORMAL ]=(DI[100:TR THERMO NORMAL]) ;
   3:  DO[149:GUN ARM SWING ADVANCE ]=(DI[101:GUN ARM SWING ADVANCE]) ;
   4:  DO[150:GUN ARM SWING RETURN ]=(DI[102:GUN ARM SWING RETURN]) ;
   5:  DO[158:FLOW SW ON ]=(DI[110:FLOW SW ON]) ;
   6:  DO[159:AUTO TIP DRESSER NFBOFF ]=(DI[111:AUTO TIP DRESSER NFB OFF]) ;
   7:  DO[110]=(DI[158]) ;
   8:  DO[111:AUTO TIPDRESS MOTOR ON]=(DI[159:AUTO TIPDRESS MOTOR ON ]) ;
   9:  DO[112:AUTOTIPDRESERAIR BLOWON]=(DI[160:AUTOTIPDRESERAIR BLOWON ]) ;
/POS
/END
