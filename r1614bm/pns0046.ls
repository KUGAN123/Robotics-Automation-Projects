/PROG  PNS0046
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "RBC HR10";
PROG_SIZE	= 492;
CREATE		= DATE 26-05-26  TIME 10:02:24;
MODIFIED	= DATE 26-05-26  TIME 10:02:32;
FILE_NAME	= PNS0043;
VERSION		= 0;
LINE_COUNT	= 17;
MEMORY_SIZE	= 812;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  R[71:RBC CYL TIME]=TIMER[8]    ;
   2:  TIMER[8]=RESET ;
   3:  TIMER[8]=START ;
   4:   ;
   5:  OVERRIDE=20% ;
   6:  R[80]=R[50:SPOT COUNT]    ;
   7:  CALL IO_RESET    ;
   8:  DO[15:IWS START]=ON ;
   9:  R[71:RBC CYL TIME]=0    ;
  10:  R[54:RBC]=0    ;
  11:  CALL RBC_35JPH_APR    ;
  12:  R[81]=R[50:SPOT COUNT]    ;
  13:  CALL IO_RESET    ;
  14:  DO[15:IWS START]=OFF ;
  15:  TIMER[8]=STOP ;
  16:  R[54:RBC]=R[81]-R[80]    ;
  17:  R[71:RBC CYL TIME]=TIMER[8]    ;
/POS
/END
