/PROG  PNS0042
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "HBC PH2";
PROG_SIZE	= 496;
CREATE		= DATE 26-04-06  TIME 19:45:38;
MODIFIED	= DATE 26-05-25  TIME 10:29:36;
FILE_NAME	= PNS0052;
VERSION		= 0;
LINE_COUNT	= 18;
MEMORY_SIZE	= 812;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  R[72:HBC CYL TIME]=TIMER[1]    ;
   2:  TIMER[1]=RESET ;
   3:  TIMER[1]=START ;
   4:  CALL IO_RESET    ;
   5:  DO[15:IWS START]=ON ;
   6:  R[72:HBC CYL TIME]=0    ;
   7:  R[80]=R[50:SPOT COUNT]    ;
   8:  R[55:HBC]=0    ;
   9:  CALL HBC_35JPH_APR    ;
  10:   ;
  11:  DO[15:IWS START]=OFF ;
  12:  R[81]=R[50:SPOT COUNT]    ;
  13:   ;
  14:  R[55:HBC]=R[81]-R[80]    ;
  15:  CALL IO_RESET    ;
  16:  TIMER[1]=STOP ;
  17:  R[72:HBC CYL TIME]=TIMER[1]    ;
  18:   ;
/POS
/END
