/PROG  PNS0057
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "PY1B_LHD GCC";
PROG_SIZE	= 512;
CREATE		= DATE 26-04-06  TIME 19:53:26;
MODIFIED	= DATE 26-05-25  TIME 14:55:04;
FILE_NAME	= PNS0056;
VERSION		= 0;
LINE_COUNT	= 17;
MEMORY_SIZE	= 840;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  R[73:PY1B CYL TIME]=TIMER[4]    ;
   2:  TIMER[4]=RESET ;
   3:  TIMER[4]=START ;
   4:  CALL IO_RESET    ;
   5:  DO[15:IWS START]=ON ;
   6:  R[80]=R[50:SPOT COUNT]    ;
   7:  //CALL PY1BLHD_GCC_40    ;
   8:  R[56:PY1B]=0    ;
   9:  R[73:PY1B CYL TIME]=0    ;
  10:   ;
  11:  CALL PY1BCOM_35JPH_APR    ;
  12:  R[81]=R[50:SPOT COUNT]    ;
  13:  DO[15:IWS START]=OFF ;
  14:  CALL IO_RESET    ;
  15:  R[56:PY1B]=R[81]-R[80]    ;
  16:  TIMER[4]=STOP ;
  17:  R[73:PY1B CYL TIME]=TIMER[4]    ;
/POS
/END
