P[1]{
   GP1:
	UF : 0, UT : 1,		CONFIG : 'N U T, 0, 0, 0',
	X =   597.015  mm,	Y =  -522.152  mm,	Z =    90.959  mm,
	W =     -.001 deg,	P =     -.001 deg,	R =  -180.000 deg
