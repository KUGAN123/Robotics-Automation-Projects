  28:  $SGGUN1.$SGREG.$REGLONG[6]=0 ;
  29:  $SGGUN1.$SGREG.$REGLONG[7]=0 ;
  30:  $SGGUN1.$SGREG.$REGLONG[8]=0 ;
  31:  $SGGUN1.$SGREG.$REGLONG[9]=0 ;
  32:  $SGGUN1.$SGREG.$REGLONG[10]=0 ;
  33:   ;
  34:  $SGGUN1.$SGREG.$REGREAL[1]=0 ;
  35:  $SGGUN1.$SGREG.$REGREAL[2]=0 ;
  36:  $SGGUN1.$SGREG.$REGREAL[3]=0 ;
  37:  $SGGUN1.$SGREG.$REGREAL[4]=0 ;
  38:  $SGGUN1.$SGREG.$REGREAL[5]=0 ;
  39:  $SGGUN1.$SGREG.$REGREAL[6]=0 ;
  40:  $SGGUN1.$SGREG.$REGREAL[7]=0 ;
  41:  $SGGUN1.$SGREG.$REGREAL[8]=0 ;
  42:  $SGGUN1.$SGREG.$REGREAL[9]=0 ;
  43:  $SGGUN1.$SGREG.$REGREAL[10]=0 ;
  44:   ;
  45:  CALL TWKINIT(1) ;
  46:   ;
