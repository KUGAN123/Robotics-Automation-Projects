  54:   ;
  55:L PR[10:APPROACHTIPBLOCK] 1000mm/sec FINE    ;
  56:L PR[11:TIP BLOCK] 1000mm/sec FINE    ;
  57:   ;
  58:  CALL TWKFXTCH(1,10,20) ;
  59:   ;
  60:L PR[11:TIP BLOCK] 1000mm/sec FINE    ;
  61:L PR[10:APPROACHTIPBLOCK] 1000mm/sec FINE    ;
