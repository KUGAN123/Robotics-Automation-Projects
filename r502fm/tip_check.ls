/PROG  TIP_CHECK
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "";
PROG_SIZE	= 715;
CREATE		= DATE 18-10-25  TIME 11:00:24;
MODIFIED	= DATE 18-10-25  TIME 11:00:24;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 13;
MEMORY_SIZE	= 1167;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:  IF R[80]=0 AND DI[153]=OFF,JMP LBL[1] ;
   2:L P[1] 1000mm/sec CNT30    ;
   3:  DO[101:GUNARM SWING ADVANCE]=OFF ;
   4:  DO[102:GUNARM SWING RETURN]=ON ;
   5:  WAIT DI[102:GUNARM SWING RETURN]=ON    ;
   6:  DO[102:GUNARM SWING RETURN]=OFF ;
   7:  WAIT R[81]=1 OR DI[154]=ON    ;
   8:  DO[101:GUNARM SWING ADVANCE]=ON ;
   9:  WAIT DI[101:GUNARM SWING ADVANCE]=ON    ;
  10:  DO[101:GUNARM SWING ADVANCE]=OFF ;
  11:  LBL[1] ;
  12:  R[80]=0    ;
  13:  R[81]=0    ;
/POS
P[1]{
   GP1:
	UF : 0, UT : 1,		CONFIG : 'N U T, 0, 0, 0',
	X =   -70.566  mm,	Y = -1403.467  mm,	Z =     9.872  mm,
	W =    23.188 deg,	P =   -82.187 deg,	R =   -18.975 deg
   GP2:
	UF : 0, UT : 1,	
	J1=   -40.000  mm
};
/END
