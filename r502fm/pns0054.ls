MODIFIED	= DATE 26-05-25  TIME 10:00:42;
FILE_NAME	= PNS0050;
VERSION		= 0;
LINE_COUNT	= 19;
MEMORY_SIZE	= 846;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:   ;
   2:  R[74:PY1B RH CYL TIME]=TIMER[8]    ;
   3:  TIMER[8]=RESET ;
   4:  TIMER[8]=START ;
   5:  CALL IO_RST    ;
   6:  R[80]=R[50:SPOT COUNT ]    ;
   7:  DO[15]=ON ;
   8:  R[74:PY1B RH CYL TIME]=0    ;
   9:  R[57:PY1B RHD]=0    ;
  10:  //CALL PY1BRHD_30JPH_DEC    ;
  11:   ;
  12:  CALL PY1BRHD_35JPH_APR    ;
  13:  R[81]=R[50:SPOT COUNT ]    ;
  14:  DO[15]=OFF ;
  15:  CALL IO_RST    ;
  16:   ;
  17:  TIMER[8]=STOP ;
  18:  R[57:PY1B RHD]=R[81]-R[80]    ;
  19:  R[74:PY1B RH CYL TIME]=TIMER[8]    ;
/POS
/END
