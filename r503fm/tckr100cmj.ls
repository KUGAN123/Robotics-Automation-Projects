MODIFIED	= DATE 26-02-19  TIME 08:06:04;
FILE_NAME	= TCKR100C;
VERSION		= 0;
LINE_COUNT	= 20;
MEMORY_SIZE	= 1127;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
/MN
   1:  !R503 ;
   2:   ;
   3:  UFRAME_NUM=0 ;
   4:  UTOOL_NUM=1 ;
   5:  PAYLOAD[1] ;
   6:   ;
   7:J PR[10] 50% FINE    ;
   8:  CALL TWKZRCLB(1,10,20) ;
   9:L PR[10] 1000mm/sec FINE    ;
  10:   ;
  11:L PR[11] 1000mm/sec FINE    ;
  12:  CALL TWKFXTCH(1,10,20,R[332]) ;
  13:L PR[11] 1000mm/sec FINE    ;
  14:L PR[10] 1000mm/sec FINE    ;
  15:  //J P[1:SUB HOME] 50% FINE    ;
  16:   ;
  17:   ;
  18:  UFRAME_NUM=0 ;
  19:  UTOOL_NUM=1 ;
  20:  PAYLOAD[1] ;
/POS
P[1:"SUB HOME"]{
   GP1:
	UF : 0, UT : 1,	
	J1=   -29.201 deg,	J2=   -32.944 deg,	J3=    29.511 deg,
	J4=    21.667 deg,	J5=  -101.859 deg,	J6=  -143.162 deg
   GP2:
	UF : 0, UT : 1,	
	J1=   -63.170  mm
};
/END
