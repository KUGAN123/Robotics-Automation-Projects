/PROG  _TEST_CT
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "";
PROG_SIZE	= 2140;
CREATE		= DATE 26-04-28  TIME 07:10:50;
MODIFIED	= DATE 26-04-28  TIME 07:10:50;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 103;
MEMORY_SIZE	= 2720;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:   ;
   2:  !MIN LENGTH TIP ;
   3:  $SGGUN1.$SETUP.$MAXWDNTIP=7 ;
   4:  $SGGUN1.$SETUP.$MAXWDNRBT=7 ;
   5:   ;
   6:  !REPERE WORLD ;
   7:  $SCR_GRP[1].$COORD_MASK=31 ;
   8:   ;
   9:  !SPEED ;
  10:  $SHFTOV_ENB=1 ;
  11:   ;
  12:  !SET REGISTER INDEX ;
  13:  $SPOTEQSETUP[1].$REG_IDX[1]=50 ;
  14:  $SPOTEQSETUP[1].$TD_REG_IDX[1]=0 ;
  15:  $SPOTEQSETUP[2].$REG_IDX[1]=55 ;
  16:  $SPOTEQSETUP[2].$TD_REG_IDX[1]=0 ;
  17:   ;
  18:   ;
  19:  !SAVE ASCII ;
  20:  $ASCII_SAVE=0 ;
  21:   ;
  22:  !RESET WELD TIMER FAULT ;
  23:  $SPOTWELDIO[1].$RESET_WLDR=1 ;
  24:   ;
  25:  !LIMIT VALUE FOR R[60] ;
  26:  IF R[60]<120 AND R[60]>0,JMP LBL[1] ;
  27:  R[60]=80    ;
  28:  LBL[1] ;
  29:   ;
  30:  !LIMIT VALUE FOR R[61] ;
  31:  IF R[61]<81 AND R[61]>0,JMP LBL[2] ;
  32:  R[61]=100    ;
  33:  LBL[2] ;
  34:   ;
  35:  !TIP END LIFE WARNING ;
  36:  DO[72]=OFF ;
  37:   ;
  38:  IF R[51]>=R[61],JMP LBL[5] ;
  39:   ;
  40:  JMP LBL[6] ;
  41:   ;
  42:  LBL[5] ;
  43:  DO[72]=ON ;
  44:  LBL[6] ;
  45:   ;
  46:  !TEST TIP CHANGE ;
  47:  !TEST TIP DRESS<MAX VALUE AND ;
  48:  !TEST WELD POINT<MAX VALUE ;
  49:  IF R[61]<=R[51] AND R[60]<=R[50],JMP LBL[20] ;
  50:   ;
  51:  !TEST TIP DRESS>MAX VALUE ;
  52:  IF R[51]>R[61],JMP LBL[20] ;
  53:   ;
  54:  DO[71]=OFF ;
  55:  JMP LBL[21] ;
  56:   ;
  57:  LBL[20] ;
  58:   ;
  59:  DO[71]=ON ;
  60:  DO[70]=OFF ;
  61:  DO[69]=OFF ;
  62:  DO[68]=OFF ;
  63:   ;
  64:  CALL _EFF_MES    ;
  65:  MESSAGE[AUTO TIP CHANGE] ;
  66:   ;
  67:  !END TEST FOR TIP CHANGE ;
  68:  LBL[21] ;
  69:   ;
  70:  !TIP DRESS TEST IS NOT NEED ;
  71:  !IF TIP CHANGE ;
  72:  IF DO[71]=ON OR DO[70]=ON,JMP LBL[30] ;
  73:   ;
  74:  !TEST TIP DRESS ;
  75:  IF R[50]<R[60],JMP LBL[10] ;
  76:   ;
  77:  CALL _EFF_MES    ;
  78:  MESSAGE[AUTO TIP DRESS] ;
  79:  DO[69]=ON ;
  80:  DO[68]=OFF ;
  81:   ;
  82:  JMP LBL[30] ;
  83:   ;
  84:  LBL[10] ;
  85:  DO[69]=OFF ;
  86:   ;
  87:  !Fin test rodage ;
  88:  LBL[30] ;
  89:   ;
  90:  R[41]=1    ;
  91:   ;
  92:  DO[67]=OFF ;
  93:   ;
  94:  !ECHANGE CARRE ;
  95:  DO[67]=PULSE,0.3sec ;
  96:   ;
  97:  IF R[53]<=R[63],JMP LBL[75] ;
  98:   ;
  99:  DO[75]=ON ;
 100:   ;
 101:  MESSAGE[CUTTER TO BE CHANGD] ;
 102:   ;
 103:  LBL[75] ;
/POS
/END
